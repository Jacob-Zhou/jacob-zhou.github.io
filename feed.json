---
layout: null
permalink: /feed.json
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | jsonify }},
  "home_page_url": {{ '/' | absolute_url | jsonify }},
  "feed_url": {{ '/feed.json' | absolute_url | jsonify }},
  "description": {{ site.description | strip_html | jsonify }},
  "authors": [
    {
      "name": {{ site.title | jsonify }},
      "url": {{ '/' | absolute_url | jsonify }},
      "avatar": {{ site.avatar | absolute_url | jsonify }}
    }
  ],
  "items": [
    {% assign visible_posts = site.posts | where_exp: "post", "post.published != false and post.hidden != true" %}
    {% for post in visible_posts %}
    {
      "id": {{ post.id | absolute_url | jsonify }},
      "url": {{ post.url | absolute_url | jsonify }},
      "title": {{ post.title | jsonify }},
      "content_text": {{ post.description | default: post.excerpt | strip_html | strip_newlines | jsonify }},
      "summary": {{ post.description | default: post.excerpt | strip_html | strip_newlines | jsonify }},
      "date_published": {{ post.date | date_to_xmlschema | jsonify }},
      "language": {{ post.lang | default: site.lang | jsonify }},
      "tags": {{ post.tags | default: empty | jsonify }},
      "authors": [
        {
          "name": {{ post.author | default: site.title | jsonify }},
          "url": {{ '/' | absolute_url | jsonify }}
        }
      ]
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
